# Auf dem VPS als $DEPLOY_PATH/.env anlegen (chmod 600). Nie committen.
DB_PASSWORD=bitte-aendern

# Optional, Zugang "reddit" für Gallery-Configs (Cookie oder Authorization-Header eines eigenen Reddit-Kontos)
GALLERY_CREDENTIALS_REDDIT_COOKIE=
GALLERY_CREDENTIALS_REDDIT_AUTHORIZATION=

# Optional, Speicher fürs Backend
BACKEND_JAVA_OPTS=-Xmx2g

# Werden von den GitHub Actions gepflegt (zum Start "latest" lassen oder weglassen)
BACKEND_TAG=latest
FRONTEND_TAG=latest
